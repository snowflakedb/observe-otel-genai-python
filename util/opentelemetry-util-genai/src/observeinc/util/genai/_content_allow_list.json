{
  "version": 1,
  "source": "Attributes the Observe backend keeps when it redacts GenAI telemetry, limited to keys that Observe's GenAI SDKs emit",
  "keep": [
    "error.category",
    "error.type",
    "exception.type",
    "gen_ai.agent.description",
    "gen_ai.agent.id",
    "gen_ai.agent.name",
    "gen_ai.agent.version",
    "gen_ai.conversation.id",
    "gen_ai.operation.name",
    "gen_ai.output.type",
    "gen_ai.provider.name",
    "gen_ai.request.choice.count",
    "gen_ai.request.encoding_formats",
    "gen_ai.request.frequency_penalty",
    "gen_ai.request.max_tokens",
    "gen_ai.request.model",
    "gen_ai.request.presence_penalty",
    "gen_ai.request.seed",
    "gen_ai.request.stream",
    "gen_ai.request.temperature",
    "gen_ai.request.thinking.budget_tokens",
    "gen_ai.request.thinking.enabled",
    "gen_ai.request.tool_choice",
    "gen_ai.request.top_p",
    "gen_ai.response.finish_reasons",
    "gen_ai.response.id",
    "gen_ai.response.model",
    "gen_ai.token.type",
    "gen_ai.tool.call.id",
    "gen_ai.tool.description",
    "gen_ai.tool.name",
    "gen_ai.tool.type",
    "gen_ai.usage.cache_read.input_tokens",
    "gen_ai.usage.cache_write.input_tokens",
    "gen_ai.usage.input_tokens",
    "gen_ai.usage.output_tokens",
    "gen_ai.usage.reasoning.output_tokens",
    "genai.conversation.turn_index",
    "genai.conversation.turn_role",
    "genai.generation.id",
    "genai.parent_generation_ids",
    "genai.sdk.name",
    "server.address",
    "server.port",
    "user.id"
  ],
  "content": [
    "gen_ai.embeddings.input_texts",
    "gen_ai.input.messages",
    "gen_ai.output.messages",
    "gen_ai.system_instructions",
    "gen_ai.tool.call.arguments",
    "gen_ai.tool.call.result",
    "gen_ai.tool.definitions"
  ]
}
