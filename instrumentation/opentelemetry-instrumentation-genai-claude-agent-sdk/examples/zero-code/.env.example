# Copy this file to .env, which is git-ignored, and put your real key there.
ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY

# Uncomment and change to your OTLP endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

OTEL_SERVICE_NAME=opentelemetry-python-claude-agent-sdk

# opentelemetry-instrument already defaults this to otlp. Uncomment if your
# OTLP endpoint doesn't accept logs.
# OTEL_LOGS_EXPORTER=console

# Prompt and completion content capture. One of NO_CONTENT, SPAN_ONLY,
# EVENT_ONLY or SPAN_AND_EVENT; any other value falls back to NO_CONTENT.
# Change to NO_CONTENT to stop capturing content.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT
